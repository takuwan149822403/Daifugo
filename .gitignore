*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.cache/

# ローカルのPython環境
.venv*/
venv/
env/
.python-runtime/

# 実行ファイル・ビルド中間物・画面プレビュー
/obj/
/build/
/dist/
*.spec

# ローカル設定・認証情報
